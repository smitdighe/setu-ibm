# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
# Region endpoint — default: us-south
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite model to use for all generative tasks
# ASSUMPTION: granite-13b-instruct-v2 used throughout; swap to granite-3-8b-instruct for lower latency
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ─── IBM Cloudant ─────────────────────────────────────────────────────────────
CLOUDANT_URL=https://your-account.cloudantnosqldb.appdomain.cloud
CLOUDANT_API_KEY=your_cloudant_api_key_here

# ─── IBM Cloud Object Storage ─────────────────────────────────────────────────
COS_API_KEY=your_cos_api_key_here
COS_SERVICE_INSTANCE_ID=your_cos_crn_here
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
# Bucket names — created automatically by migrate.ts if not present
COS_LESSON_BUCKET=setu-lesson-plans

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_to_a_random_32_char_string
NEXTAUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
